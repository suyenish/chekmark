# Claude API. Enter your real key only in .env, never in this file. Required in production.
ANTHROPIC_API_KEY=
# Model chosen by the Stage 0 mark test.
AI_MODEL=
# Prices per million tokens, used to calculate cost per page.
AI_INPUT_COST_PER_MTOK=
AI_OUTPUT_COST_PER_MTOK=

# Local PostgreSQL from docker-compose.yml. Start it with: docker compose up -d
DATABASE_URL=postgresql://chekmark:chekmark@localhost:5432/chekmark

# Sign-in. During Stage 1 only these comma-separated addresses can sign in.
ALLOWED_EMAILS=
# Where the web app runs. Sign-in links point here.
APP_URL=http://localhost:5173
# Email for sign-in links, for example smtps://user:password@smtp.example.com:465.
# Leave empty in development: links are then printed in the API log. Required in production.
SMTP_URL=
MAIL_FROM=Chekmark <no-reply@localhost>

# Photo storage (S3-compatible). Locally this is SeaweedFS from docker-compose.yml.
# In production, use your provider's endpoint and keys, or leave S3_ENDPOINT empty for Amazon S3.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=chekmark-photos
# Local SeaweedFS accepts any keys. Put real keys only in .env or your host's settings.
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local

# Job queue (Redis from docker-compose.yml).
REDIS_URL=redis://localhost:6379

# Daily pages per user, and the app-wide monthly AI spending cap in US dollars.
DAILY_PAGE_LIMIT=5
AI_MONTHLY_BUDGET_USD=20
# Gets an email when the monthly AI budget is reached.
OWNER_EMAIL=
