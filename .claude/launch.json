{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "set -a && . ./.env && set +a && export SIGN_UP=\"${SIGN_UP:-open}\" && cd apps/api && corepack pnpm start:dev"
      ],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "web",
        "dev"
      ],
      "port": 5173
    }
  ]
}
