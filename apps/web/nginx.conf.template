# Filled in at start: ${API_UPSTREAM} comes from the environment, and ${NGINX_LOCAL_RESOLVERS}
# is the container's own DNS server (read from /etc/resolv.conf by the nginx image).

# Look the API up again every 10 seconds instead of once at start. On a platform such as Railway a
# redeployed API gets a new address, and the API may not exist yet when the web server starts.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=on;
resolver_timeout 3s;

server {
  listen 8080;
  listen [::]:8080;
  server_name _;
  root /usr/share/nginx/html;

  # Sent with every answer. The app loads only its own scripts, styles, fonts and images (photos come
  # from /api, previews are blob: addresses), talks only to its own /api, and may not be framed by other sites.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "same-origin" always;
  add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
  add_header Strict-Transport-Security "max-age=31536000" always;
  server_tokens off;

  # Compress text on the way out: the scripts and styles shrink to about a third.
  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json text/plain;
  gzip_vary on;

  # Photos are uploaded through here; the API refuses anything above 10 MB.
  client_max_body_size 12m;

  # The API, on the same site, so the session cookie is a first-party cookie.
  # A variable in proxy_pass makes nginx resolve the name per request through the resolver above.
  set $api_upstream ${API_UPSTREAM};
  location ~ ^/api(/.*)$ {
    proxy_pass http://$api_upstream$1$is_args$args;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }

  # Built files have content hashes in their names, so they can be cached for a long time.
  location /assets/ {
    expires 1y;
    try_files $uri =404;
  }

  # Every other path is a screen of the app (/review, /pages/…): serve the app and let it route.
  location / {
    expires -1;
    try_files $uri /index.html;
  }
}
